-- Pulse 标准库：函数模板。
--
-- 模板格式为 `name(__p1, __p2, ...) = <expr>`；参数使用 __p1..__pn 命名，
-- 该命名空间不在信号名字符集内，不会与真实信号冲突。调用时先把实参文本
-- 拼接进模板体再解析——因此参数可以出现在任意语法位置。
--
-- 标准库完全由现有时序语法构成，没有求值器内建函数。边沿函数借助固定
-- 延迟算子 `->N`（左侧在右侧恰好 N 拍前为真）表达历史采样：
--   rise(x)   = !x ->1 x            （x 前一拍为假、当前拍为真）
--   fall(x)   = x ->1 !x            （x 前一拍为真、当前拍为假）
--   stable(x) = (x ->1 x) || (!x ->1 !x)   （x 与前一拍相同）
-- 窗口起点之前没有历史：`->N` 要求"前 N 拍存在"，边沿函数不会在首拍触发。

rise(__p1)   = !(__p1) ->1 (__p1)
fall(__p1)   = (__p1) ->1 !(__p1)
stable(__p1) = ((__p1) ->1 (__p1)) || (!(__p1) ->1 !(__p1))
