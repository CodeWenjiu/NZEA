export TMPDOR=/tmp
PATH_add "$PWD/.direnv/bin"
# zaozi-lsp, built into the tree by `just zed-setup` (per-clone, gitignored): the Zed extension resolves it from
# the worktree PATH, and this entry reaches Zed through the `load_direnv: direct` setting in .zed/settings.json.
PATH_add "$PWD/.zed/ls/bin"

if [[ -t 0 ]] || [[ -n "${REQUIRE_FLAKE:-}" ]]; then
  use flake
fi

export MILL_NO_SEPARATE_BSP_OUTPUT_DIR=1

# waveform trace for wavepeek debugging
export NZEA_TRACE_FST="$PWD/../remu/target/trace.fst"
