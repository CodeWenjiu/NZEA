//| mill-jvm-version: system
import mill._
import mill.scalalib._

val scalaV    = "3.8.4"
val zaoziV    = "0.0.1-SNAPSHOT"
val utestV    = "0.8.4"
val mainargsV = "0.7.6"
val upickleV  = "4.0.2"

/** JVM flags the DSL needs at run time: the FFM bindings load libMLIR/libCIRCT by name. */
def zaoziJvmFlags: Seq[String] =
  val libraryPaths = Seq("MLIR_INSTALL_PATH", "CIRCT_INSTALL_PATH")
    .flatMap(sys.env.get)
    .map(_ + "/lib")
    .mkString(":")
  Seq("--enable-native-access=ALL-UNNAMED", s"-Djava.library.path=$libraryPaths")

def utestDeps: Seq[Dep] = Seq(mvn"com.lihaoyi::utest:$utestV")

/** Common Scala 3 setup: JDK 25 output and SemanticDB for the language server. */
trait Scala3Module extends ScalaModule {
  override def scalaVersion = scalaV

  override def scalacOptions = Task {
    super.scalacOptions() ++ Seq(
      "-java-output-version",
      "25",
      "-Xsemanticdb",
      "-sourceroot",
      mill.api.BuildCtx.workspaceRoot.toString
    )
  }
}

/** Modules that build hardware with the zaozi DSL.
  *
  * Requires the zaozi toolchain from the dev shell (`CIRCT_INSTALL_PATH` / `MLIR_INSTALL_PATH`) and the locally
  * published `.zaozi` submodule (`just zaozi-publish`).
  */
trait ZaoziModule extends Scala3Module {
  override def scalacOptions = Task {
    super.scalacOptions() ++ Seq("-experimental") ++ zaoziPluginArgs()
  }

  override def mvnDeps = Task {
    super.mvnDeps() ++ Seq(
      mvn"me.jiuyang::zaozi:$zaoziV",
      mvn"me.jiuyang::stdlib:$zaoziV",
      mvn"com.lihaoyi::mainargs:$mainargsV",
      mvn"com.lihaoyi::upickle:$upickleV"
    )
  }

  override def forkArgs = Task {
    super.forkArgs() ++ zaoziJvmFlags
  }

  /** The zaozi SemanticDB-enhancer compiler plugin.
    *
    * Bundle fields reached through `scala.Dynamic` (`io.<field>`) get no use-site occurrences from a plain scalac
    * run, so go-to/references on them would land on the access itself (or on `selectDynamic`). The plugin's batch
    * phase injects those occurrences into the emitted SemanticDB, and its interactive phase steers the language
    * server's presentation compiler to the field declaration.
    */
  override def scalacPluginMvnDeps = Task {
    super.scalacPluginMvnDeps() ++ Seq(mvn"me.jiuyang::zaozi-compiler-plugin:$zaoziV")
  }

  /** The plugin as scalac options: `scalacOptions` is what the language server reads over BSP, while Mill's own plugin
    * classpath is invisible there. Taken from the resolved plugin classpath (filtered by artifact name, since it also
    * carries scala-library) and hashed into the compile inputs through `scalacPluginClasspath`.
    */
  private def zaoziPluginArgs = Task {
    scalacPluginClasspath()
      .map(_.path)
      .filter(_.last.startsWith("zaozi-compiler-plugin"))
      .map(path => s"-Xplugin:$path")
  }
}

/** Configuration model: leaf module, no hardware dependencies. */
object nzea_config extends Scala3Module {
  object test extends ScalaTests with TestModule.Utest {
    def mvnDeps = utestDeps
  }
}

object nzea_rtl extends ZaoziModule {
  object test extends ScalaTests with TestModule.Utest {
    def mvnDeps = utestDeps

    // Elaboration tests load libMLIR/libCIRCT through the FFM API.
    override def forkArgs = Task {
      super.forkArgs() ++ zaoziJvmFlags
    }
  }
}

/** The core: front (IFU/IDU), middle (register reads, CSR) and back (FUs, LSU). */
object nzea_core extends ZaoziModule {
  override def moduleDeps = super.moduleDeps ++ Seq(nzea_rtl, nzea_config)

  object test extends ScalaTests with TestModule.Utest {
    def mvnDeps = utestDeps

    // Reuse nzea_rtl's elaborate -> firtool helper, and load libMLIR/libCIRCT through the FFM API.
    override def moduleDeps = super.moduleDeps ++ Seq(nzea_rtl.test)

    override def forkArgs = Task {
      super.forkArgs() ++ zaoziJvmFlags
    }
  }
}

/** Command line: the one place that turns flags into an elaboration (which module, which platform, where it goes). */
object nzea_cli extends ZaoziModule {
  override def moduleDeps = super.moduleDeps ++ Seq(nzea_core, nzea_rtl, nzea_config)
}
