import mill._
import mill.scalalib._

val scalaV  = "2.13.18"
val chiselV = "7.10.0"
val mainargsVersion = "0.5.2"
val scalatestVersion = "3.2.19"

val sharedScalacOptions = Seq(
  "-language:reflectiveCalls",
  "-deprecation",
  "-feature",
  "-Xcheckinit",
  "-Ymacro-annotations"
)

object nzea_cli extends ScalaModule {
  def scalaVersion = scalaV

  def moduleDeps = Seq(nzea_core, nzea_tile, nzea_config)

  override def mvnDeps = Seq(mvn"com.lihaoyi::mainargs:$mainargsVersion")
}

object nzea_config extends ScalaModule {
  def scalaVersion = scalaV
  def moduleDeps = Seq(nzea_core)
  override def mvnDeps = Seq(mvn"com.lihaoyi::mainargs:$mainargsVersion")
}

object nzea_rtl extends ScalaModule {
  def scalaVersion = scalaV
  def chiselVersion = chiselV

  override def scalacOptions = sharedScalacOptions

  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def mvnDeps = Seq(mvn"org.scalatest::scalatest:$scalatestVersion")
    def forkEnv = Map("PATH" -> sys.env.getOrElse("PATH", ""))
  }
}

object nzea_core extends ScalaModule {
  def scalaVersion = scalaV
  def chiselVersion = chiselV

  def moduleDeps = Seq(nzea_rtl)

  override def scalacOptions = sharedScalacOptions

  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def mvnDeps = Seq(mvn"org.scalatest::scalatest:$scalatestVersion")
  }
}

object nzea_tile extends ScalaModule {
  def scalaVersion = scalaV

  def moduleDeps = Seq(nzea_core, nzea_rtl, nzea_config)

  override def scalacOptions = sharedScalacOptions

  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselV")
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselV"
  )
}
