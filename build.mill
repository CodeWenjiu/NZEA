import mill._
import mill.scalalib._

val scalaV = "3.8.4"
val zaoziV = "0.0.1-SNAPSHOT"
val utestV = "0.8.4"

/** Shared setup for every module of the core.
  *
  * Requires the zaozi toolchain: `nix develop` (JDK 25 + CIRCT/MLIR) and the
  * locally published `.zaozi` submodule (`just z-publish` — see legacy/README.md).
  */
trait ZaoziModule extends ScalaModule {
  override def scalaVersion = scalaV

  override def scalacOptions = Task {
    super.scalacOptions() ++ Seq(
      "-experimental",
      "-java-output-version",
      "25",
      "-Xsemanticdb",
      "-sourceroot",
      mill.api.BuildCtx.workspaceRoot.toString
    )
  }

  override def mvnDeps = Task {
    super.mvnDeps() ++ Seq(
      mvn"me.jiuyang::zaozi:$zaoziV",
      mvn"com.lihaoyi::mainargs:0.7.6",
      mvn"com.lihaoyi::upickle:4.0.2"
    )
  }

  // The DSL reaches CIRCT through the FFM API.
  override def forkArgs = Task {
    super.forkArgs() ++ Seq("--enable-native-access=ALL-UNNAMED")
  }
}

object nzea_rtl extends ZaoziModule {
  object test extends ScalaTests with TestModule.Utest {
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:$utestV")
  }
}
