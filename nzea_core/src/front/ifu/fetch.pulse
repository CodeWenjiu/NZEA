-- Fetch-stage events, relative to the fetcher's scope (TOP.NzeaCore.core.front.ifu).
--
-- Bind them to compose with other scopes, e.g. an instruction stream against the retire events in the middle's file:
--   pulse property --event nzea_core/src/front/ifu/fetch.pulse <IFU> Fetch \
--       --event nzea_core/src/middle/retire.pulse <MIDDLE> Core \
--       --eval 'Core.redirect --40 Fetch.i_fetch'

-- A fetch request the bus accepted: this is the cycle the pc advances on.
i_fetch = ibus_req_valid && ibus_req_ready

-- The bus answered, whatever the response's epoch: a killed stream is digested, not refused.
i_resp = ibus_resp_valid

-- A request is waiting for the bus. Stuck high is a fetch deadlock (the ready side never comes). The bridge answers
-- from an elastic slot, so steady state barely holds it: a request is refused only while a response waits to be taken
-- (`i_stall` counting the same cycles as `i_resp` was the refusing slot's signature, before the elastic one).
i_stall = ibus_req_valid && !ibus_req_ready

-- A fetched word the register between fetch and decode took, which is what carries the stream forward.
out_fire = out_valid && out_ready
