-- Core retire and dispatch events, relative to the middle's scope (TOP.NzeaCore.core.middle).
--
-- These are the events the retire counters cannot answer: the counters say how many, these say when and in what order.
-- Bind them with --event, e.g. the commit log with its redirects marked:
--   pulse property --event nzea_core/src/middle/retire.pulse <MIDDLE> Core \
--       --eval 'Core.commit_fire || Core.redirect' --cycles 0-500

-- One instruction retired: register write-back, CSR write and the commit trace all ride this pulse.
commit_fire = commit_valid

-- A taken branch: the write-back register holds a mispredicted branch, so the middle flushes the younger stages and the
-- front restarts from `wb_redirect_target`. The baseline predicts not-taken, so a taken branch is also a mispredict.
redirect = flushing

-- There is an instruction in the middle: the uop the units work on, or a payload waiting for its operands.
inflight = isexValid || idisValid

-- A uop's first cycle in the execute slot: the cycle after the read placed its operands, and the one the units take as
-- the uop's beginning.
uop_issue = first

-- The payload holds although the execute slot is free: what stops it is its own operands — it reads the very
-- instruction that is finishing below it, and the write it waits for lands a cycle later.
operand_wait = idisValid && !idis_ready && (!isexValid || complete_valid) && !flushing