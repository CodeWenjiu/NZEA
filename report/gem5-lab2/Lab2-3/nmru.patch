diff --git a/configs/common/CacheConfig.py b/configs/common/CacheConfig.py
index 4f21a43..49e10ee 100644
--- a/configs/common/CacheConfig.py
+++ b/configs/common/CacheConfig.py
@@ -72,6 +72,12 @@ def _get_cache_opts(level, options):
     if hasattr(options, prefetcher_attr):
         opts["prefetcher"] = _get_hwp(getattr(options, prefetcher_attr))
 
+    rp_attr = f"{level}_replacement_policy"
+    if hasattr(options, rp_attr) and getattr(options, rp_attr) is not None:
+        opts["replacement_policy"] = ObjectList.rp_list.get(
+            getattr(options, rp_attr)
+        )()
+
     return opts
 
 
